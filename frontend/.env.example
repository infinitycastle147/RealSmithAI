# Clerk Authentication
# Get your publishable key from: https://dashboard.clerk.com → Your App → API Keys → Publishable Key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# Backend API URL (optional for development - uses Vite proxy if not set)
# In production, set this to your backend URL (e.g., https://api.yourdomain.com)
VITE_API_URL=
